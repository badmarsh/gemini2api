GEMINI_PSID=your__Secure-1PSID_cookie_value
GEMINI_PSIDTS=your__Secure-1PSIDTS_cookie_value
API_KEY=
# Optional: Dedicated auth key for the admin dashboard/API (if empty, falls back to API_KEY)
ADMIN_API_KEY=
# Optional: CORS allowed origins (default '*' matches upstream behavior; can be comma-separated list)
CORS_ALLOW_ORIGINS=*
CORS_ALLOW_CREDENTIALS=true
REFRESH_INTERVAL=5
MAX_RETRIES=3
PORT=5918
LOG_LEVEL=info
RATE_LIMIT_ENABLED=false
RATE_LIMIT_WINDOW=60
RATE_LIMIT_MAX=10
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_INTERVAL=5
ACCOUNTS_FILE=accounts.json
ROTATION_STRATEGY=round-robin
MAX_CONCURRENT_PER_ACCOUNT=8
# Queue timeout (seconds) waiting for an available account slot before returning an error
ACQUIRE_TIMEOUT=60.0
# Fast retries on the same account upon 5xx before failing over; cooldown (seconds) for rate-limited accounts
SAME_ACCOUNT_5XX_RETRIES=1
FAILOVER_COOLDOWN=30.0
# Fingerprint / version sync / jitter
FINGERPRINT_CONFIG_PATH=data/fingerprint.json
VERSION_SYNC_ENABLED=true
VERSION_SYNC_INTERVAL=24
JITTER_ENABLED=true
# Usage statistics
USAGE_STATS_ENABLED=true
USAGE_STATS_INTERVAL=300
USAGE_STATS_RETENTION_DAYS=30
# Model whitelist (comma-separated, empty = allow all)
MODEL_WHITELIST=
# Gemini Web chat automatic cleanup
CHAT_CLEANUP_ENABLED=true
CHAT_CLEANUP_KEEP_HOURS=24.0
CHAT_CLEANUP_INTERVAL_HOURS=6.0
CHAT_CLEANUP_SKIP_PINNED=true
# Native Gemini extended thinking (triggered by reasoning_effort)
EXTENDED_THINKING_ENABLED=true
# Image proxy download size suffix (=s0 for full original resolution) and single download timeout (seconds)
IMAGE_DOWNLOAD_SIZE_SUFFIX==s2048
IMAGE_DOWNLOAD_TIMEOUT=25.0
# Gemini -> Third-party fallback: automatically retry with third-party models in the API Key pool upon error
FALLBACK_ENABLED=false
FALLBACK_MODELS=
# Third-party provider failover: cooldown period (seconds) when a provider errors or runs out of quota
THIRDPARTY_FAILOVER_COOLDOWN=180.0
# Record full request and response bodies in dashboard logs (disabled by default for privacy)
LOG_BODIES_ENABLED=false
# Gemini 4 Argon fallback to Gemini Flash 3.8 High (thinking enabled)
ARGON_FALLBACK_TO_FLASH=true
ARGON_ALWAYS_FALLBACK=false
ARGON_FALLBACK_MODEL=gemini-flash-thinking

# Note: Settings modified via the web dashboard are persisted in data/settings-overrides.json
# and replayed on startup with higher priority than this file or environment variables.
# If an edit in this file does not take effect, check the startup log for
# "Applied N panel setting override(s)" and remove data/settings-overrides.json.
