{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "BabysitTask",
  "description": "Schema for synthetic tasks generated by Orchestrator for Argon 4 agent",
  "type": "object",
  "required": [
    "task_id",
    "category",
    "difficulty",
    "title",
    "prompt",
    "tools",
    "expected_behavior"
  ],
  "properties": {
    "task_id": {
      "type": "string",
      "pattern": "^task_[0-9a-zA-Z_-]+$",
      "description": "Unique task identifier"
    },
    "category": {
      "type": "string",
      "enum": [
        "tool_use",
        "multistep_planning",
        "long_context",
        "faulty_ambiguous",
        "tool_recovery",
        "filesystem",
        "stall_resistance",
        "format_constraints"
      ],
      "description": "Taxonomy category of the task"
    },
    "difficulty": {
      "type": "string",
      "enum": ["low", "medium", "high", "extreme"],
      "description": "Difficulty level of the task"
    },
    "title": {
      "type": "string",
      "maxLength": 128,
      "description": "Short descriptive title of the task"
    },
    "prompt": {
      "type": "string",
      "description": "Input prompt sent to the Argon agent"
    },
    "tools": {
      "type": "array",
      "description": "Function tools available to Argon for this task",
      "items": {
        "type": "object",
        "required": ["type", "function"],
        "properties": {
          "type": { "type": "string", "enum": ["function"] },
          "function": {
            "type": "object",
            "required": ["name", "description", "parameters"],
            "properties": {
              "name": { "type": "string" },
              "description": { "type": "string" },
              "parameters": { "type": "object" }
            }
          }
        }
      }
    },
    "expected_behavior": {
      "type": "object",
      "required": ["success_criteria", "timeout_seconds"],
      "properties": {
        "success_criteria": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Checkable criteria to determine if the task passed"
        },
        "max_turns": {
          "type": "integer",
          "minimum": 1,
          "default": 10,
          "description": "Maximum allowed turn iterations"
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 60,
          "default": 360,
          "description": "Timeout in seconds (must be >= 360 for Argon)"
        },
        "expected_artifacts": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Files expected to be created in the sandbox"
        }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
