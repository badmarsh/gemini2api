diff --git a/tests/unit/test_admin_argon_status.py b/tests/unit/test_admin_argon_status.py
new file mode 100644
index 0000000..f9a1e13
--- /dev/null
+++ b/tests/unit/test_admin_argon_status.py
@@ -0,0 +1,73 @@
+"""/admin/status must explain an Argon slowdown, and /admin/argon/reset must be able to end it.
+
+Before this, "Argon is slow / answers nothing" had no answer in the panel: the stall breaker lived in a module
+nobody could see, the agent-loop counter was only in the logs, and the only way out of an open breaker was to
+wait out ARGON_STALL_BREAKER_SECONDS.
+"""
+from app.config import settings
+from app.core import agent_loop, argon_breaker
+from app.utils.tools import TOOL_LOOP_REMINDER
+
+_AUTH = {"Authorization": "Bearer sk-test-key", "X-Admin-Key": "sk-test-key"}
+
+
+def _get(client, path):
+    return client.get(path, headers=_AUTH)
+
+
+def _post(client, path):
+    return client.post(path, headers=_AUTH)
+
+
+def test_status_reports_the_argon_and_agent_loop_state(client, monkeypatch):
+    argon_breaker.reset()
+    agent_loop.reset_stats()
+    monkeypatch.setattr(settings, "argon_stall_breaker_seconds", 60)
+    argon_breaker.trip("first-frame", "TimeoutError")
+
+    body = _get(client, "/admin/status").json()
+    argon = body["argon"]
+    assert argon["open"] is True
+    assert argon["reason"] == "first-frame"
+    assert argon["note"] == "TimeoutError"
+    assert 0 < argon["seconds_left"] <= 60
+    assert argon["trips"] >= 1
+
+    loop = body["agent_loop"]
+    assert loop["detected"] == 0 and loop["corrected"] == 0
+    assert loop["tool_loop_reminder"] is True
+    assert loop["stall_guard"] is True
+    assert loop["fallback_model"] == settings.argon_fallback_model
+    assert "salvaged_empty_streams" in loop
+    argon_breaker.reset()
+
+
+def test_reset_closes_the_breaker(client, monkeypatch):
+    monkeypatch.setattr(settings, "argon_stall_breaker_seconds", 60)
+    argon_breaker.trip("timeout", "")
+    assert argon_breaker.is_open()
+
+    body = _post(client, "/admin/argon/reset").json()
+    assert body["success"] is True
+    assert body["was_open"] is True
+    assert body["argon"]["open"] is False
+    assert argon_breaker.is_open() is False
+
+
+def test_breaker_with_a_zero_ttl_stays_closed_but_still_counts_trips(monkeypatch):
+    """ARGON_STALL_BREAKER_SECONDS=0 disables the substitution, not the observability."""
+    argon_breaker.reset()
+    monkeypatch.setattr(settings, "argon_stall_breaker_seconds", 0)
+    assert argon_breaker.enabled() is False
+    argon_breaker.trip("timeout", "")
+    assert argon_breaker.is_open() is False
+    snap = argon_breaker.snapshot()
+    assert snap["trips"] >= 1 and snap["open"] is False
+    argon_breaker.reset()
+
+
+def test_reminder_text_is_the_one_the_model_actually_sees():
+    """Guard against editing the reminder into something that no longer forbids promises."""
+    low = TOOL_LOOP_REMINDER.lower()
+    assert "tool_call" in low
+    assert "promise" in low
diff --git a/tests/unit/test_agent_loop_guard.py b/tests/unit/test_agent_loop_guard.py
new file mode 100644
index 0000000..23f7f21
--- /dev/null
+++ b/tests/unit/test_agent_loop_guard.py
@@ -0,0 +1,120 @@
+"""Agent-loop guard (app/core/agent_loop.py).
+
+The failure this covers: inside a coding harness the model answers with a *promise* ("I'll inspect the files
+now and let you know") instead of a tool_call. The harness only sees text, assumes the assistant is done and
+goes idle -- the user has to nudge it by hand, every round.
+
+Contract under test:
+- a promise-shaped reply is detected (EN and SK), everything else is left alone;
+- detection is conservative: code fences, tool payloads, long answers, empty text and plain questions are not
+  stalls;
+- the correction asks the model exactly once, and only the corrected text that actually carries a tool call
+  replaces the original;
+- a failing regenerator never turns a graceful reply into an error.
+"""
+import asyncio
+
+from app.core import agent_loop
+
+
+def _run(coro):
+    return asyncio.run(coro)
+
+
+# ---- looks_like_stall -----------------------------------------------------------------------------------
+
+def test_promise_replies_are_stalls():
+    for text in (
+        "I'll inspect the files and let you know.",
+        "I am working on it now.",
+        "Let me check the repository structure first.",
+        "I will report back once the implementation is done.",
+        "Give me a moment to review the code.",
+        "Pracujem na tom, dám ti vedieť.",
+        "Idem na to a spustil som realizáciu.",
+        "Začínam implementáciou Canvas enginu.",
+        "Budem ťa informovať po nasadení.",
+    ):
+        assert agent_loop.looks_like_stall(text), text
+
+
+def test_real_answers_are_not_stalls():
+    for text in (
+        "",
+        "   ",
+        "Done. The file static/app/canvas-engine.js now contains the sandbox.",
+        "Tests pass: 80 passed in 4.2s.",
+        "Which directory should the engine live in?",
+        '{"status": "tool_use", "tool_calls": [{"name": "read_file", "arguments": {"path": "a.py"}}]}',
+        "```python\nprint('I will not be retried')\n```",
+        "I'll inspect " * 200,          # long answer = work product, not a stall
+    ):
+        assert not agent_loop.looks_like_stall(text), text
+
+
+# ---- guard_tool_loop ------------------------------------------------------------------------------------
+
+def test_guard_retries_once_and_uses_the_tool_call():
+    calls = []
+
+    async def regenerate(nudge):
+        calls.append(nudge)
+        return '{"status": "tool_use", "tool_calls": [{"name": "ls", "arguments": {}}]}'
+
+    text, corrected = _run(agent_loop.guard_tool_loop("I'll start by inspecting the repo.", regenerate))
+    assert corrected is True
+    assert len(calls) == 1, "the guard must never retry more than once"
+    assert "tool_call" in calls[0], "the corrective nudge must be what is passed to the regenerator"
+    assert '"tool_calls"' in text
+
+
+def test_guard_keeps_the_first_reply_when_the_retry_still_promises():
+    async def regenerate(nudge):
+        return "Let me check the files and I'll report back."
+
+    text, corrected = _run(agent_loop.guard_tool_loop("I'll inspect the files.", regenerate))
+    assert corrected is False
+    assert text == "I'll inspect the files."
+
+
+def test_guard_keeps_the_first_reply_when_the_retry_fails():
+    async def regenerate(nudge):
+        raise RuntimeError("upstream exploded")
+
+    text, corrected = _run(agent_loop.guard_tool_loop("I'll inspect the files.", regenerate))
+    assert corrected is False
+    assert text == "I'll inspect the files."
+
+
+def test_guard_is_inert_for_non_stalls_and_when_disabled():
+    calls = []
+
+    async def regenerate(nudge):
+        calls.append(nudge)
+        return "never used"
+
+    # a plain answer: nothing to correct
+    text, corrected = _run(agent_loop.guard_tool_loop("All tests pass.", regenerate))
+    assert (text, corrected) == ("All tests pass.", False)
+    # disabled by setting: not even the detection runs
+    text, corrected = _run(agent_loop.guard_tool_loop("I'll inspect the files.", regenerate, enabled=False))
+    assert (text, corrected) == ("I'll inspect the files.", False)
+    assert calls == []
+
+
+def test_stats_count_detections_and_corrections():
+    agent_loop.reset_stats()
+
+    async def good(nudge):
+        return '{"status": "tool_use", "tool_calls": [{"name": "ls", "arguments": {}}]}'
+
+    async def bad(nudge):
+        return "I'll do it later."
+
+    _run(agent_loop.guard_tool_loop("I'll inspect the files.", good))
+    _run(agent_loop.guard_tool_loop("Pracujem na tom.", bad))
+    _run(agent_loop.guard_tool_loop("Nothing to see here.", good))
+
+    assert agent_loop.stats() == {"detected": 2, "corrected": 1}
+    agent_loop.reset_stats()
+    assert agent_loop.stats() == {"detected": 0, "corrected": 0}
diff --git a/tests/unit/test_argon_fallback_serving.py b/tests/unit/test_argon_fallback_serving.py
new file mode 100644
index 0000000..a67e8a7
--- /dev/null
+++ b/tests/unit/test_argon_fallback_serving.py
@@ -0,0 +1,194 @@
+"""Argon -> Flash fallback (app/core/argon_fallback.py): one implementation, and no silent substitutions.
+
+Covered:
+- plan(): Argon by default; the stall breaker and ARGON_ALWAYS_FALLBACK are named substitutions;
+- generate(): an upstream error / empty reply / Google web error degrades to the fallback model and marks the
+  result with ``argon_fallback``; with the fallback off the original error propagates;
+- generate_stream(): a dead-but-silent Argon stream gets exactly one plain Argon retry, then the fallback
+  starts *behind a serve_marker frame* before any content -- and once content has streamed, nothing switches;
+- conversation_id is forwarded to the pool (regression: the first version dropped it).
+"""
+import asyncio
+
+import pytest
+
+from app.config import settings
+from app.core import argon_breaker, argon_fallback
+
+
+def _run(coro):
+    return asyncio.run(coro)
+
+
+class _Pool:
+    """Minimal account_pool stand-in: records the calls, replays scripted answers per model."""
+
+    def __init__(self, non_stream=None, stream=None):
+        self.calls = []
+        self.stream_calls = []
+        self._non_stream = list(non_stream or [])
+        self._stream = list(stream or [])
+
+    async def generate(self, prompt, model, conversation_id="", attachments=None,
+                       gem_id=None, account_id=None, extended_thinking=False):
+        self.calls.append({"model": model, "conversation_id": conversation_id, "thinking": extended_thinking})
+        item = self._non_stream.pop(0)
+        if isinstance(item, Exception):
+            raise item
+        return item
+
+    async def generate_stream(self, prompt, model, conversation_id="", attachments=None,
+                              gem_id=None, account_id=None, extended_thinking=False):
+        self.stream_calls.append({"model": model, "conversation_id": conversation_id})
+        for evt in self._stream.pop(0):
+            if isinstance(evt, Exception):
+                raise evt
+            yield evt
+
+
+_OK_ARGON = {"text": "argon answer", "images": [], "thoughts": "", "conversation_id": "c1"}
+_EMPTY = {"text": "", "images": [], "thoughts": "", "conversation_id": "c1"}
+_WEB_ERROR = {"text": "Sorry, something went wrong. Please try your request again.", "images": [],
+              "thoughts": "", "conversation_id": "c1"}
+_FLASH_OK = {"text": "flash answer", "images": [], "thoughts": "", "conversation_id": "c2"}
+
+
+@pytest.fixture(autouse=True)
+def _reset_breaker():
+    argon_breaker.reset()
+    yield
+    argon_breaker.reset()
+
+
+# ---- plan -----------------------------------------------------------------------------------------------
+
+def test_plan_argon_by_default():
+    model, is_argon, thinking, served = argon_fallback.plan("gemini-4-argon", "gemini-4-argon")
+    assert (model, is_argon, thinking) == ("gemini-4-argon", True, False)
+    assert served == argon_fallback.SERVED_BY_ARGON
+
+
+def test_plan_names_the_stall_breaker_substitution(monkeypatch):
+    monkeypatch.setattr(settings, "argon_stall_breaker_seconds", 60)
+    argon_breaker.trip("first-frame", "TimeoutError")
+    model, is_argon, thinking, served = argon_fallback.plan("gemini-4-argon", "gemini-4-argon")
+    assert served == "stall_breaker"
+    assert model == settings.argon_fallback_model
+    assert (is_argon, thinking) == (False, True)
+
+
+def test_plan_names_always_fallback(monkeypatch):
+    monkeypatch.setattr(settings, "argon_always_fallback", True)
+    _, _, _, served = argon_fallback.plan("gemini-4-argon", "gemini-4-argon")
+    assert served == "argon_always_fallback"
+
+
+# ---- generate -------------------------------------------------------------------------------------------
+
+def test_generate_passes_argon_conversation_id_through():
+    pool = _Pool(non_stream=[_OK_ARGON])
+    result = _run(argon_fallback.generate(pool, "p", "gemini-4-argon", None,
+                                          is_argon=True, conversation_id="gconv-9"))
+    assert result["text"] == "argon answer"
+    assert pool.calls[0]["conversation_id"] == "gconv-9"
+    assert "argon_fallback" not in result
+
+
+def test_generate_falls_back_and_marks_on_error():
+    pool = _Pool(non_stream=[RuntimeError("upstream 500"), _FLASH_OK])
+    result = _run(argon_fallback.generate(pool, "p", "gemini-4-argon", None, is_argon=True))
+    assert result["text"] == "flash answer"
+    assert result["argon_fallback"]["served_by"] == argon_fallback.SERVED_BY_FLASH
+    assert result["argon_fallback"]["reason"] == "argon_error"
+    assert pool.calls[1]["model"] == settings.argon_fallback_model
+    assert pool.calls[1]["thinking"] is True
+
+
+def test_generate_falls_back_on_empty_and_web_error_replies():
+    for bad, reason in ((_EMPTY, "empty_reply"), (_WEB_ERROR, "google_web_error")):
+        pool = _Pool(non_stream=[bad, _FLASH_OK])
+        result = _run(argon_fallback.generate(pool, "p", "gemini-4-argon", None, is_argon=True))
+        assert result["argon_fallback"]["reason"] == reason
+        assert result["text"] == "flash answer"
+
+
+def test_generate_raises_when_the_fallback_is_disabled(monkeypatch):
+    monkeypatch.setattr(settings, "argon_fallback_to_flash", False)
+    pool = _Pool(non_stream=[RuntimeError("boom")])
+    with pytest.raises(RuntimeError, match="boom"):
+        _run(argon_fallback.generate(pool, "p", "gemini-4-argon", None, is_argon=True))
+
+
+def test_generate_raises_the_fallback_error_when_both_fail():
+    pool = _Pool(non_stream=[RuntimeError("argon dead"), RuntimeError("flash dead too")])
+    with pytest.raises(RuntimeError, match="flash dead too"):
+        _run(argon_fallback.generate(pool, "p", "gemini-4-argon", None, is_argon=True))
+
+
+def test_generate_never_returns_an_empty_completion_when_the_fallback_is_on():
+    """An empty Argon reply must not reach the client as a successful completion."""
+    pool = _Pool(non_stream=[_EMPTY, _EMPTY])
+    result = _run(argon_fallback.generate(pool, "p", "gemini-4-argon", None, is_argon=True))
+    assert result["text"] == ""          # both empty: nothing better exists, but it is marked...
+    assert result["argon_fallback"]["reason"] == "empty_reply"   # ...so the routers/headers can say so
+
+
+# ---- generate_stream ------------------------------------------------------------------------------------
+
+def _collect(pool, **kw):
+    async def run():
+        return [evt async for evt in argon_fallback.generate_stream(pool, "p", "gemini-4-argon", None, **kw)]
+    return _run(run())
+
+
+def test_stream_argon_success_has_no_marker():
+    pool = _Pool(stream=[[{"type": "delta", "text": "hi"},
+                          {"type": "final", "text": "hi", "images": [], "thoughts": "",
+                           "conversation_id": "c1"}]])
+    events = _collect(pool, is_argon=True, conversation_id="g")
+    assert [e["type"] for e in events] == ["delta", "final"]
+    assert pool.stream_calls[0]["conversation_id"] == "g"
+
+
+def test_stream_empty_answer_retries_argon_once_then_falls_back():
+    pool = _Pool(
+        stream=[[{"type": "final", "text": "", "images": [], "thoughts": "", "conversation_id": "c1"}]],
+        non_stream=[_OK_ARGON],   # the single plain-Argon retry succeeds
+    )
+    events = _collect(pool, is_argon=True, conversation_id="g")
+    assert [e["type"] for e in events] == ["delta", "thoughts", "final"]
+    assert events[0]["text"] == "argon answer"
+    assert not any(e["type"] == "serve_marker" for e in events), "a successful retry needs no marker"
+    assert len(pool.calls) == 1, "exactly one non-streaming retry"
+
+
+def test_stream_dead_answer_retries_then_emits_the_marker_before_flash_content():
+    pool = _Pool(
+        stream=[[{"type": "final", "text": "", "images": [], "thoughts": "", "conversation_id": "c1"}],
+                [{"type": "delta", "text": "flash "}, {"type": "final", "text": "flash answer",
+                                                       "images": [], "thoughts": "", "conversation_id": "c2"}]],
+        non_stream=[_EMPTY],
+    )
+    events = _collect(pool, is_argon=True, conversation_id="g")
+    assert [e["type"] for e in events] == ["serve_marker", "delta", "final"]
+    assert events[0]["served_by"] == argon_fallback.SERVED_BY_FLASH
+    assert events[0]["reason"] == "empty_stream"
+    assert pool.stream_calls[-1]["model"] == settings.argon_fallback_model
+
+
+def test_stream_error_before_any_content_falls_back_behind_the_marker():
+    pool = _Pool(
+        stream=[[RuntimeError("connect reset")],
+                [{"type": "final", "text": "flash answer", "images": [], "thoughts": "",
+                  "conversation_id": "c2"}]],
+    )
+    events = _collect(pool, is_argon=True)
+    assert events[0]["type"] == "serve_marker"
+    assert events[0]["reason"] == "argon_error"
+
+
+def test_stream_never_switches_after_content_was_streamed():
+    pool = _Pool(stream=[[{"type": "delta", "text": "half an ans"}, RuntimeError("connection lost")]])
+    with pytest.raises(RuntimeError, match="connection lost"):
+        _collect(pool, is_argon=True)
+    assert len(pool.stream_calls) == 1, "no silent second attempt after content went out"
diff --git a/tests/unit/test_argon_request_uuid_pairing.py b/tests/unit/test_argon_request_uuid_pairing.py
new file mode 100644
index 0000000..b1a9f47
--- /dev/null
+++ b/tests/unit/test_argon_request_uuid_pairing.py
@@ -0,0 +1,134 @@
+"""StreamGenerate payload/header invariants the Argon rework got wrong.
+
+1. **Companion UUID pairing.** ``_encode_payload_thinking`` mints one per-request UUID, stores it at
+   ``inner[59]`` and returns it; the ``x-goog-ext-525005358-jspb`` header must echo that SAME UUID. The Argon
+   rewrite threw the returned value away (``encoded, _ = ...``) and minted a second, unrelated UUID for the
+   header — upstream paired them, and nothing documented the change. One invariant test per call site.
+2. **No server-side continuation.** ``inner[2]`` is the metadata block, not a conversation slot, so a stored
+   ``conversation_id`` cannot be honoured. That is reported once instead of being discovered by a user whose
+   agent suddenly answers without context.
+"""
+import asyncio
+import json
+
+import pytest
+
+import app.core.gemini_client as gc
+
+
+class _Jar:
+    def get_all(self):
+        return {}
+
+    def set(self, *a, **k):
+        return None
+
+    def update_from_response(self, *a, **k):
+        return None
+
+
+def _client():
+    c = gc.GeminiWebClient(psid="psid", psidts="psidts")
+    c._cookie_jar = _Jar()
+    c._current_target = gc.header_builder.get_impersonate_target()
+    c._session_token = "token"
+    c._healthy = True
+    return c
+
+
+def _inner_uuid(request_body: dict) -> str:
+    inner = json.loads(json.loads(request_body["f.req"])[1])
+    return inner[59]
+
+
+# ---- 1. payload <-> header UUID pairing -----------------------------------------------------------------
+
+def test_send_request_echoes_the_payload_uuid_in_the_companion_header():
+    client = _client()
+    captured = {}
+
+    class FakeResp:
+        status_code = 500
+        text = "nope"
+
+    class FakeSession:
+        async def post(self, url, **kwargs):
+            captured.update(kwargs.get("data") or {})
+            captured["headers"] = kwargs.get("headers") or {}
+            return FakeResp()
+
+    client._http = FakeSession()
+
+    with pytest.raises(Exception):
+        asyncio.run(client._send_request("prompt", model="gemini-4-argon"))
+
+    header_uuid = json.loads(captured["headers"]["x-goog-ext-525005358-jspb"])[0]
+    assert header_uuid == _inner_uuid(captured), (
+        "the companion header UUID and the payload's inner[59] must be the same per-request id"
+    )
+
+
+def test_generate_stream_echoes_the_payload_uuid_in_the_companion_header():
+    client = _client()
+    captured = {}
+
+    class FakeStreamCtx:
+        def __init__(self, **kwargs):
+            captured.update(kwargs.get("data") or {})
+            captured["headers"] = kwargs.get("headers") or {}
+
+        async def __aenter__(self):
+            raise RuntimeError("stop stream test")
+
+        async def __aexit__(self, *args):
+            return False
+
+    class FakeSession:
+        def stream(self, method, url, **kwargs):
+            return FakeStreamCtx(**kwargs)
+
+    client._http = FakeSession()
+
+    async def drain():
+        async for _ in client.generate_stream("hi", model="gemini-4-argon"):
+            pass
+
+    with pytest.raises(RuntimeError, match="stop stream test"):
+        asyncio.run(drain())
+
+    header_uuid = json.loads(captured["headers"]["x-goog-ext-525005358-jspb"])[0]
+    assert header_uuid == _inner_uuid(captured)
+    assert header_uuid == header_uuid.upper(), "the protocol form is upper-case"
+
+
+# ---- 2. the conversation slot does not exist ------------------------------------------------------------
+
+def test_thinking_payload_has_no_conversation_slot():
+    inner = json.loads(json.loads(
+        _client()._encode_payload_thinking("hi", "gemini-4-argon", "gconv-123", None, None)[0])[1])
+    assert inner[2] != "gconv-123", "inner[2] is the metadata block, not a conversation id"
+    assert isinstance(inner[2], list)
+    assert "gconv-123" not in json.dumps(inner), "the id must not leak into an unrelated slot"
+
+
+def test_dropped_conversation_is_reported_once(monkeypatch, caplog):
+    monkeypatch.setattr(gc, "_continuation_drop_warned", False)
+    client = _client()
+    with caplog.at_level("WARNING", logger="app.core.gemini_client"):
+        client._encode_payload_thinking("hi", "gemini-4-argon", "gconv-123", None, None)
+        client._encode_payload_thinking("hi", "gemini-4-argon", "gconv-456", None, None)
+
+    hits = [r for r in caplog.records if "cannot continue a stored conversation" in r.getMessage()]
+    assert len(hits) == 1, "the warning must be logged once per process, not per request"
+    assert "gconv" not in caplog.text, "the opaque conversation id must not be printed"
+
+
+def test_legacy_encoder_is_not_used_at_runtime():
+    """`_encode_payload` is kept only as a byte-identity reference; runtime must use the thinking payload."""
+    src = (gc.__file__ and open(gc.__file__, encoding="utf-8").read()) or ""
+    body = src.split("def _encode_payload_thinking", 1)[1]
+    for line in body.splitlines():
+        stripped = line.strip()
+        if stripped.startswith("#") or "def " in stripped:
+            continue
+        assert "self._encode_payload(" not in stripped, "legacy 4-element payload is back on the hot path"
